#!/usr/bin/make -f

export PYBUILD_NAME=opentelemetry-instrumentation-asgi
export PYBUILD_DIR=instrumentation/opentelemetry-instrumentation-asgi

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_configure:
	sed -i 's/__version__ = "0\.65b0\.dev"/__version__ = "0.64b0"/' \
	    instrumentation/opentelemetry-instrumentation-asgi/src/opentelemetry/instrumentation/asgi/version.py
	sed -i 's/dynamic = \["version"\]/version = "0.64b0"/' \
	    instrumentation/opentelemetry-instrumentation-asgi/pyproject.toml
	sed -i '/\[tool\.hatch\.version\]/,/^$$/d' instrumentation/opentelemetry-instrumentation-asgi/pyproject.toml
	sed -i 's/opentelemetry-instrumentation == 0\.65b0\.dev/opentelemetry-instrumentation >= 0.64b0/' \
	    instrumentation/opentelemetry-instrumentation-asgi/pyproject.toml
	sed -i 's/opentelemetry-semantic-conventions == 0\.65b0\.dev/opentelemetry-semantic-conventions >= 0.64b0/' \
	    instrumentation/opentelemetry-instrumentation-asgi/pyproject.toml
	sed -i 's/opentelemetry-util-http == 0\.65b0\.dev/opentelemetry-util-http >= 0.64b0/' \
	    instrumentation/opentelemetry-instrumentation-asgi/pyproject.toml
	dh_auto_configure

override_dh_auto_test:
	# Skip tests - test dependencies not packaged

override_dh_auto_clean:
	dh_auto_clean
	git checkout instrumentation/opentelemetry-instrumentation-asgi/pyproject.toml instrumentation/opentelemetry-instrumentation-asgi/src/opentelemetry/instrumentation/asgi/version.py 2>/dev/null || true
