#!/usr/bin/make -f

export PYBUILD_NAME=opentelemetry-instrumentation
export PYBUILD_DIR=opentelemetry-instrumentation

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_configure:
	sed -i 's/__version__ = "0\.65b0\.dev"/__version__ = "0.64b0"/' \
	    opentelemetry-instrumentation/src/opentelemetry/instrumentation/version.py
	sed -i 's/dynamic = \["version"\]/version = "0.64b0"/' \
	    opentelemetry-instrumentation/pyproject.toml
	sed -i '/\[tool\.hatch\.version\]/,/^$$/d' opentelemetry-instrumentation/pyproject.toml
	sed -i 's/opentelemetry-semantic-conventions == 0\.65b0\.dev/opentelemetry-semantic-conventions >= 0.64b0/' \
	    opentelemetry-instrumentation/pyproject.toml
	# Debian's packaged python3-hatchling (1.27.0) validates classifiers
	# against an older trove-classifiers list that does not yet know
	# "Framework :: OpenTelemetry" or Python 3.13/3.14, and raises a hard
	# ValueError during the build backend's metadata step. Strip these
	# unrecognized classifiers; they carry no functional meaning for the
	# Debian package.
	sed -i '/"Framework :: OpenTelemetry",/d; /"Programming Language :: Python :: 3\.1[34]",/d' \
	    opentelemetry-instrumentation/pyproject.toml
	dh_auto_configure

override_dh_auto_test:
	# Skip tests - test dependencies not packaged

override_dh_auto_clean:
	dh_auto_clean
	git checkout opentelemetry-instrumentation/pyproject.toml opentelemetry-instrumentation/src/opentelemetry/instrumentation/version.py 2>/dev/null || true
